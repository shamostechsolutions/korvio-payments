# =============================================================================
# VERCEL — copy to Vercel env vars (NO quotes around values in Vercel UI)
# =============================================================================

# If password has # & @ % etc, URL-encode it in the connection string:
#   # → %23    & → %26    @ → %40
# Example: password "abc#123" becomes abc%23123 in the URL

# Transaction pooler (6543) — app runtime on Vercel
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct / session connection (5432) — local seed & migrate deploy
# Supabase → Connect → Session pooler (port 5432), NOT transaction pooler (6543)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://ozhcyqxxdcqbsdryvbfn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3h7tBFhdW9F8zWiDwHrsfw_icpSkCP2

APP_URL=https://korvio.vercel.app
NEXT_PUBLIC_APP_URL=https://korvio.vercel.app
NEXT_PUBLIC_APP_NAME=Korvio

AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=korvio-verify-token
WHATSAPP_BUSINESS_NUMBER=256700000000

PAYMENT_PROVIDER=pawapay
MOCK_AUTO_COMPLETE=false
PAYMENT_WEBHOOK_SECRET=korvio-payment-webhook-secret

# --- PawaPay (https://docs.pawapay.io/v2/docs/how_to_start) ---
# Generate token: PawaPay Dashboard → Developers → API tokens
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=sandbox
PAWAPAY_DEFAULT_COUNTRY=UGA
PAWAPAY_DEFAULT_CURRENCY=UGX
PAWAPAY_MTN_PROVIDER=MTN_MOMO_UGA
PAWAPAY_AIRTEL_PROVIDER=AIRTEL_OAPI_UGA
# Use hosted checkout (default). Set true for direct deposit + phone PIN prompt.
PAWAPAY_USE_DEPOSIT=false
# Cash-outs always require platform admin approval before PawaPay sends money.

# Callback URLs to paste in PawaPay Dashboard → Callback URLs:
#   Checkouts:  {APP_URL}/api/webhooks/pawapay/checkouts
#   Deposits:   {APP_URL}/api/webhooks/pawapay/deposits
#   Payouts:    {APP_URL}/api/webhooks/pawapay/payouts
#   Refunds:    {APP_URL}/api/webhooks/pawapay/refunds

# --- Flutterwave (legacy) ---
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Platform super-admin only (/admininterface) — comma-separated, no quotes on Vercel
PLATFORM_ADMIN_EMAILS=shamos@korvio.com

# Cash-out minimum (smallest currency unit, e.g. 50000 = UGX 50,000)
MIN_CASHOUT_AMOUNT=50000
# Korvio fee deducted at cash-out (default 6.5%)
PLATFORM_FEE_RATE=0.065

# =============================================================================
# LOCAL DEV — uncomment to use Docker Postgres locally
# =============================================================================
# DATABASE_URL=postgresql://korvio:korvio@localhost:5434/korvio?schema=public
# DIRECT_URL=postgresql://korvio:korvio@localhost:5434/korvio?schema=public
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_SECRET=korvio-dev-secret-change-me-in-production
