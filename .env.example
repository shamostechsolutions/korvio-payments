# =============================================================================
# VERCEL — copy to Vercel env vars (NO quotes around values in Vercel UI)
# =============================================================================

# If password has # & @ % etc, URL-encode it in the connection string:
#   # → %23    & → %26    @ → %40
# Example: password "abc#123" becomes abc%23123 in the URL

# Transaction pooler (6543) — app runtime on Vercel
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (5432) — local seed, migrate deploy (Supabase → Connect → Direct)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://ozhcyqxxdcqbsdryvbfn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3h7tBFhdW9F8zWiDwHrsfw_icpSkCP2

APP_URL=https://korvio.vercel.app
NEXT_PUBLIC_APP_URL=https://korvio.vercel.app
NEXT_PUBLIC_APP_NAME=Korvio

AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=korvio-verify-token
WHATSAPP_BUSINESS_NUMBER=256700000000

PAYMENT_PROVIDER=flutterwave
MOCK_AUTO_COMPLETE=false
PAYMENT_WEBHOOK_SECRET=korvio-payment-webhook-secret
FLUTTERWAVE_SECRET_KEY=FLWSECK-fdb8c7259b771244fb854681808f1b22-1947b1d5f2cvt-X
FLUTTERWAVE_WEBHOOK_HASH=
# Platform super-admin only (/admininterface) — comma-separated, no quotes on Vercel
PLATFORM_ADMIN_EMAILS=shamos@korvio.com

# =============================================================================
# LOCAL DEV — uncomment to use Docker Postgres locally
