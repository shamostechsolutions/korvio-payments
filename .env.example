# =============================================================================
# VERCEL — copy to Vercel env vars (NO quotes around values in Vercel UI)
# =============================================================================

# If password has # & @ % etc, URL-encode it in the connection string:
#   # → %23    & → %26    @ → %40
# Example: password "abc#123" becomes abc%23123 in the URL

# Transaction pooler (6543) — app runtime
DATABASE_URL=postgresql://postgres.ozhcyqxxdcqbsdryvbfn:iNXkNrcukcW27@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (5432) — migrations (use pooler host, NOT db.*.supabase.co — Vercel can't reach direct host)
DIRECT_URL=postgresql://postgres.ozhcyqxxdcqbsdryvbfn:iNXkNrcukcW27@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://ozhcyqxxdcqbsdryvbfn.supabase.co
